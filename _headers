# Revalidate the entry point and mutable bundles; versioned URLs refresh old clients.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/assets/main.js
  Cache-Control: public, max-age=0, must-revalidate
/assets/template.css
  Cache-Control: public, max-age=0, must-revalidate
